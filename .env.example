# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ubuntu Notification Filters (optional)
# Filter by app name (comma separated)
FILTER_APPS=

# Keywords to filter notifications (comma separated)
FILTER_KEYWORDS=AI,agent,finished,waiting,completed,done

# Enable/disable filtering for Ubuntu notifications
ENABLE_FILTERS=false

# AI Agent Event Filters (optional)
# Filter by agent name (comma separated)
FILTER_AGENT_NAMES=Claude Code

# Filter by event type (comma separated)
# Available types: agent_started, agent_stopped, waiting_for_input, task_completed, tool_used, error_occurred
FILTER_EVENT_TYPES=agent_stopped,waiting_for_input

# Enable/disable filtering for AI agent events
ENABLE_AGENT_FILTERS=false
