{
  "name": "agent-telegraph",
  "version": "1.0.0",
  "description": "Forward AI agent events to Telegram in real-time",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:hooks": "tsc && chmod +x hooks/*.sh",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "hook:test": "echo '{\"taskDescription\":\"Test task\"}' | node dist/hooks/claude-stop-handler.js"
  },
  "keywords": [
    "ai-agents",
    "telegram",
    "claude-code"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/node-telegram-bot-api": "^0.64.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "node-telegram-bot-api": "^0.66.0"
  }
}
